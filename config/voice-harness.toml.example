# voice-harness example configuration.
# Copy to config/voice-harness.toml and fill in keys (or set VH_<SECTION>__<KEY> env vars,
# e.g. VH_STT__API_KEY=... — env wins over file).

[server]
bind = "127.0.0.1:8090"
api_keys = []                      # empty = require none (localhost/LAN trust)
# Browser origins allowed on the /v1/realtime WebSocket (cross-site WebSocket
# hijacking guard). Native clients send no Origin header and are always
# allowed; an empty list rejects EVERY browser origin. Exact-match entries:
# allowed_origins = ["https://home.example.com"]

[stt]
base_url = "http://127.0.0.1:8000"
api_key = "SET-ME"
chat_path = "/v1/audio/transcriptions"
model = "asr-model"                # e.g. whisper-large-v3, parakeet

[stt.realtime]                      # streaming STT over the ASR server's realtime WS (nemo-speech.cpp)
enabled = false                     # default off; batch above remains the fallback
path = "/v1/audio/transcriptions/realtime"
endpointing_ms = 700                # end-of-utterance silence threshold (server-side endpointing)
language = ""                       # empty = model default; e.g. "en-US"

[tts]
base_url = "http://127.0.0.1:8000"
api_key = "SET-ME"
speech_path = "/v1/audio/speech"
model = "tts-model"                # e.g. kokoro, piper-tts, xtts
voice = "default"
response_format = "wav"
raw_sample_rate = 16000             # sample rate of upstream *raw* PCM (ignored for WAV responses)

[llm]
# Open WebUI example: base_url ends in /api, chat_path starts with /v1/ —
# the two are concatenated (don't double-prefix). Plain OpenAI-compatible
# servers: base_url = "http://127.0.0.1:8080", chat_path = "/v1/chat/completions".
base_url = "http://127.0.0.1:3000/api"
api_key = "SET-ME"
chat_path = "/v1/chat/completions"
model = "default"
# reasoning_effort = "low"            # optional: sent as `reasoning_effort` on every request ("minimal"/"low"/"medium"/"high"); unset = not sent

[session]
silence_ms = 700
min_utterance_ms = 300
max_utterance_ms = 30000
pre_speech_ms = 500
chunk_max_chars = 200
max_history_turns = 8
idle_timeout_secs = 600
# Sentence-end gate: hold a transcribed utterance that lacks terminal
# punctuation (. ! ? …) and concatenate it with the next utterance, so a
# mid-sentence pause (an "uh", a breath) doesn't fire a separate LLM turn.
require_sentence_end = true
# A held fragment dispatches anyway after this much silence with no
# continuation (deadline is deferred while speech is in progress), and an
# explicit speech.end flushes it immediately.
sentence_end_wait_ms = 2000

[prompts]
system = "You are a helpful home voice assistant. Answer concisely — 1 to 3 sentences unless the user asks for detail. Speak plainly; never output markdown, code fences, or lists. You can call tools when useful."
# system_file = "system-prompt.md"   # optional: load the system prompt from a markdown file (path relative to this config); overrides `system`

[plugins]
enabled = ["time", "web_search", "weather"]

# Optional web search + page fetch via a self-hosted Firecrawl instance.
# Tools surface as web_search.search / web_search.fetch. Requires base_url;
# without it an enabled web_search plugin contributes no tools.
# [plugins.web_search]
# base_url = "http://127.0.0.1:3002"
# api_key = ""                             # only for cloud Firecrawl

# Optional weather plugin tuning (Open-Meteo, keyless). Defaults omitted =
# official endpoints; uncomment to use a self-hosted instance or a default
# home location for "what's the weather?".
# [plugins.weather]
# default_location = "Portland, Oregon"   # used when the user asks for weather without naming a place
# api_base = ""                            # full forecast endpoint URL override
# geocoding_base = ""                      # full geocoding endpoint URL override
# units = "imperial"                       # default units when the LLM omits them (empty = metric)

# Optional MCP (Model Context Protocol) servers, exposed as tools `mcp.<name>.<tool>`.
# OAuth tokens are persisted to token_store (chmod 600, never commit it). Authorize
# an OAuth server once with: harness-server auth <name> [config-path]
# [plugins.mcp]
# token_store = "config/mcp-tokens.json"
# [[plugins.mcp.servers]]
# name = "weather"
# url = "https://mcp.example.com/mcp"
# auth = "bearer"
# api_key = "SET-ME"
# [[plugins.mcp.servers]]
# name = "home"
# url = "https://mcp.example.org/mcp"
# auth = "oauth"
# scopes = ["home.read"]
# tool_allowlist = ["ha_search", "ha_get_state", "ha_bulk_control", "ha_call_service"]
#   ^ Optional: when non-empty, ONLY these upstream tools surface to the LLM and
#   are dispatchable; everything else the server advertises is pruned. Useful
#   for large servers (ha-mcp advertises 77) where the full tool-spec list would
#   bloat every LLM request, and for keeping config-editing tools (restart,
#   backups, dashboard edits) out of a voice assistant's reach.

# Client-executed personal-context tools (calendar, contacts, photos). The
# connected macOS/iOS client announces its provider catalog over the WebSocket;
# the server exposes those tools to the LLM as personal.<provider>.<tool> and
# forwards calls to the announcing client.
[personal_context]
enabled = true                       # master gate: false = no specs advertised, calls error immediately
call_timeout_secs = 10               # per client tool call wait bound before an error digest is returned
max_result_bytes = 8192              # server-side clamp on digest text length before it enters history
